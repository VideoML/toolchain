{
  "name": "@videoml/toolchain",
  "version": "0.0.0",
  "description": "VideoML toolchain: load DSL, generate timing/audio, and render videos.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dsl": "./src/dsl/index.ts",
    "./renderer": "./src/compat/renderer.ts",
    "./renderer/components/registry": "./src/compat/registry.ts",
    "./renderer/context": "./src/compat/context.ts",
    "./renderer/math": "./src/compat/math.ts",
    "./shared": "./src/compat/shared.ts"
  },
  "types": "./src/index.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/config.test.ts packages/shared/src/__tests__/dsl-to-script.test.ts",
    "test:package-wiring": "node --test tests/package-wiring.test.mjs",
    "test:packed-consumer": "sh tests/packed-consumer-smoke.sh",
    "test:conformance": "node --test tests/conformance/runner.test.mjs",
    "test:voiceover": "node --import tsx --test tests/timing/*.test.ts tests/auritus/provider.test.ts",
    "test:effects": "node --import tsx --test tests/effects/*.test.mjs",
    "test:shaders": "node --test tests/transitions/p08-browser.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.699.0",
    "@xmldom/xmldom": "^0.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "yaml": "^2.5.1",
    "@videoml/renderer": "0.0.0",
    "@videoml/shared": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.1",
    "playwright": "1.45.0",
    "typescript": "^5.7.2"
  },
  "files": [
    "src"
  ]
}
